+		    !s8_sram_ok(s8_rd(s8_sram, c + 48), len * elem)) {
+			return false;
+		}
+		if (!s8_sram_ok(s8_rd(s8_sram, c + 16), 4) || !s8_sram_ok(s8_rd(s8_sram, c + 20), 4) ||

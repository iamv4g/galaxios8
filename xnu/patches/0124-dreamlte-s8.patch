+/* Window 0 on VGF0 scaling sw x sh to dw x dh at x0; window 5 (G0) off. */
+static bool
+sweet_fb_dpp_start(uint32_t sw, uint32_t sh, uint32_t dw, uint32_t dh, uint32_t x0)
+{

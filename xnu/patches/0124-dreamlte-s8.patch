+/*
+ * Copy of the console in TWRP's ramoops pmsg zone, in persistent_ram
+ * format (sig "DBGC", start, size, ring data), appended to the loader's
+ * text there; TWRP shows it as /sys/fs/pstore/pmsg-ramoops-0 after a warm
+ * reset. Two layouts: the upstream author's TWRP (2 MiB ramoops, pmsg at
+ * 0x92180000) and TWRP 3.4.0 on the galaxios8 G950N (32 KiB ramoops,
+ * 16 KiB pmsg at 0x92004000); both get the text. The small zone wraps,
+ * so it keeps the last ~16 KiB, which is where a panic ends up.
+ */
+struct klog_zone {
+	uint64_t phys, len;
+	volatile uint32_t *hdr;
+	volatile uint8_t *data;
+	uint32_t cap, start, size;
+};
+static struct klog_zone klog_zones[] = {
+	{ .phys = A5_KLOG_PHYS, .len = A5_KLOG_SIZE },
+	{ .phys = A5_KLOG2_PHYS, .len = A5_KLOG2_SIZE },
+};
+static void klog_putc(uint8_t c);
+
+static void
+klog_init(void)
+{
+	for (unsigned i = 0; i < sizeof(klog_zones) / sizeof(klog_zones[0]); i++) {
+		struct klog_zone *z = &klog_zones[i];
+		z->hdr = (volatile uint32_t *)ml_io_map(z->phys, z->len);
+		if (z->hdr == NULL) {
+			continue;
+		}
+		z->cap = (uint32_t)z->len - 12;
+		/* Continue after the loader's text if its header is sane. */
+		if (z->hdr[0] == 0x43474244u && z->hdr[1] == z->hdr[2] && z->hdr[2] < z->cap) {
+			z->start = z->size = z->hdr[2];
+		} else {
+			z->hdr[0] = 0x43474244u;
+			z->start = z->size = 0;
+		}
+		z->data = (volatile uint8_t *)(z->hdr + 3);
+	}
+	const char *banner = "\n--- XNU console ---\n";
+	for (; *banner; banner++) {
+		klog_putc((uint8_t)*banner);
+	}
+	s8_restart_init();
+}
+
+static void
+klog_putc(uint8_t c)
+{
+	for (unsigned i = 0; i < sizeof(klog_zones) / sizeof(klog_zones[0]); i++) {
+		struct klog_zone *z = &klog_zones[i];
+		if (z->data == NULL) {
+			continue;
+		}
+		z->data[z->start] = c;
+		z->start = (z->start + 1) % z->cap;
+		if (z->size < z->cap) {
+			z->size++;
+		}
+		z->hdr[1] = z->start;
+		z->hdr[2] = z->size;
+	}
+}

+/* acpm_ipc_send_data + check_response, polled; cmd[1] carries the answer. */
+static int
+s8_acpm_send(uint32_t cmd[4])
+{
+	uint32_t c = s8_ch;
+	if (s8_rd(s8_sram, c + 12) == 2) {
+		return s8_acpm_send_buffer(cmd);

+#define JS_CONFIG_DEFAULT       (8u << 16 | 3u << 8 | 3u << 12) /* pri 8, flush start+end, AS 0 */
+#define PTE_TABLE               3ULL
+#define PTE_LEAF                (1ULL | 1ULL << 10 | 3ULL << 6 | 2ULL << 8)
+#define PTE_XN                  (1ULL << 54)

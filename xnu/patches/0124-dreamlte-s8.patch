+static void
+sweet_fb_copy_rows(const struct sweet_fb_copy_job *j)
+{
+	if (j->kind == 1) {
+		sweet_fb_scale_rows(j);
+		return;
+	}
+	for (int32_t y = 0; y < j->rows; y++) {
+		memcpy((void *)(j->dst + (uint64_t)y * j->dstride),

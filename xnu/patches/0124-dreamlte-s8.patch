+static int
+s8_acpm_send_buffer(uint32_t cmd[4])
+{
+	uint32_t c = s8_ch, elem = s8_rd(s8_sram, c + 56);
+	if (++s8_seq >= 64) {
+		s8_seq = 1;
+	}

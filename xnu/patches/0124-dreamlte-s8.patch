+static void
+sweet_fb_dpu_dump(void)
+{
+	vm_offset_t dec = ml_io_map(0x12860000, 0x2000);
+	vm_offset_t dpp = ml_io_map(0x12850000, 0x7000);
+	vm_offset_t dma = ml_io_map(0x128B0000, 0x7000);
+	if (dec == 0 || dma == 0 || dpp == 0) {
+		return;

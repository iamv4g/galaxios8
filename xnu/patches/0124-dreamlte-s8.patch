+/* Scale the stage into panel rows [0, rows), split like sweet_fb_copy. */
+static void
+sweet_fb_scale(uintptr_t dst, uint64_t dstride, uintptr_t src, uint64_t sstride, int32_t rows)
+{
+	if (sweet_fb_copy_lock == NULL) {
+		struct sweet_fb_copy_job all = { dst, src, dstride, sstride, 0, rows, 1, 0,
+			sweet_fb_rowbufs[0] };
+		sweet_fb_scale_rows(&all);
+		return;
+	}
+	int32_t parts = SWEET_FB_COPY_HELPERS + 1;
+	int32_t per = rows / parts, at = 0;
+	IOLockLock(sweet_fb_copy_lock);
+	for (int32_t i = 0; i < SWEET_FB_COPY_HELPERS; i++, at += per) {
+		sweet_fb_jobs[i] = (struct sweet_fb_copy_job){
+			dst, src, dstride, sstride, 0, per, 1, at, sweet_fb_rowbufs[i] };
+	}
+	sweet_fb_copy_left = SWEET_FB_COPY_HELPERS;
+	sweet_fb_copy_gen++;
+	IOLockWakeup(sweet_fb_copy_lock, &sweet_fb_copy_gen, false);
+	IOLockUnlock(sweet_fb_copy_lock);
+	struct sweet_fb_copy_job mine = { dst, src, dstride, sstride, 0, rows - at, 1, at,
+		sweet_fb_rowbufs[SWEET_FB_COPY_HELPERS] };
+	sweet_fb_copy_rows(&mine);
+	IOLockLock(sweet_fb_copy_lock);
+	while (sweet_fb_copy_left != 0) {
+		IOLockSleep(sweet_fb_copy_lock, &sweet_fb_copy_left, THREAD_UNINT);
+	}
+	IOLockUnlock(sweet_fb_copy_lock);
+}
+
+/* Copy rows x bytes, split over the helpers and the caller. */
+static void
+sweet_fb_copy(uintptr_t dst, uint64_t dstride, uintptr_t src, uint64_t sstride,
+    uint64_t bytes, int32_t rows)
+{
+	if (sweet_fb_copy_lock == NULL) {
+		sweet_fb_copy_lock = IOLockAlloc();
+		for (uintptr_t i = 0; sweet_fb_copy_lock != NULL && i < SWEET_FB_COPY_HELPERS; i++) {
+			thread_t t;
+			if (kernel_thread_start(sweet_fb_copy_helper, (void *)i, &t) == KERN_SUCCESS) {
+				thread_deallocate(t);
+			}
+		}
+	}
+	int32_t parts = SWEET_FB_COPY_HELPERS + 1;
+	if (sweet_fb_copy_lock == NULL || rows < 64) {
+		struct sweet_fb_copy_job all = { dst, src, dstride, sstride, bytes, rows };
+		sweet_fb_copy_rows(&all);
+		return;
+	}
+	int32_t per = rows / parts, at = 0;
+	IOLockLock(sweet_fb_copy_lock);
+	for (int32_t i = 0; i < SWEET_FB_COPY_HELPERS; i++, at += per) {
+		sweet_fb_jobs[i] = (struct sweet_fb_copy_job){
+			dst + (uint64_t)at * dstride, src + (uint64_t)at * sstride,
+			dstride, sstride, bytes, per };
+	}
+	sweet_fb_copy_left = SWEET_FB_COPY_HELPERS;
+	sweet_fb_copy_gen++;
+	IOLockWakeup(sweet_fb_copy_lock, &sweet_fb_copy_gen, false);
+	IOLockUnlock(sweet_fb_copy_lock);
+	struct sweet_fb_copy_job mine = { dst + (uint64_t)at * dstride, src + (uint64_t)at * sstride,
+		dstride, sstride, bytes, rows - at };
+	sweet_fb_copy_rows(&mine);
+	IOLockLock(sweet_fb_copy_lock);
+	while (sweet_fb_copy_left != 0) {
+		IOLockSleep(sweet_fb_copy_lock, &sweet_fb_copy_left, THREAD_UNINT);
+	}
+	IOLockUnlock(sweet_fb_copy_lock);
+}

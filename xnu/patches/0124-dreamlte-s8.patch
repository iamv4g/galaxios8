+				r[x + 3] = p3;
+			}
+			for (; x < n; x++, acc += step) {
+				r[x] = in[acc >> 16];
+			}
+			built = sweet_fb_ymap[y];
+		}
+		memcpy(out, j->row, (size_t)sweet_fb_out_w * 4);

+{
+	/* IOPlatformExpert.h: 0 halt, 1 restart, 4 panic restart,
+	 * 9 panic restart without callouts, 10 panic diagnostics done (sent
+	 * after the panic text, before debug.c waits for a KDP debugger over
+	 * serial, which K2b did forever); other types are notifications. */
+	if (s8_pmu == NULL ||
+	    (type != 0 && type != 1 && type != 4 && type != 9 && type != 10)) {
+		return 0;
+	}
+	if (type == 0) {
+		s8_pmu[0x330c / 4] &= ~0x100u;   /* PS_HOLD low: power off */
+		for (;;) {
+		}
+	}
+	if (type != 1) {

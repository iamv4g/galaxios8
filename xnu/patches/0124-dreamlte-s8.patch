+	uint32_t reason = (s8_restart_to_recovery || (type != 1 && s8_panic_to_recovery)) ?
+	    0x12345674u : 0x12345670u;     /* REASON_RECOVERY / UNKNOWN */
+	s8_pmu[0x808 / 4] = 0x12345678u;     /* INFORM2: SEC_POWER_RESET */
+	s8_pmu[0x80c / 4] = reason;          /* INFORM3 */
+	__asm__ volatile ("dsb sy" ::: "memory");

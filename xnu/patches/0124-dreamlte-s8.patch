+	for (;;) {
+		IOLockLock(sweet_fb_copy_lock);
+		while (sweet_fb_copy_gen == seen) {
+			IOLockSleep(sweet_fb_copy_lock, &sweet_fb_copy_gen, THREAD_UNINT);
+		}
+		seen = sweet_fb_copy_gen;
+		IOLockUnlock(sweet_fb_copy_lock);
+		sweet_fb_copy_rows(&sweet_fb_jobs[idx]);
+		IOLockLock(sweet_fb_copy_lock);
+		if (--sweet_fb_copy_left == 0) {
+			IOLockWakeup(sweet_fb_copy_lock, &sweet_fb_copy_left, false);
+		}
+		IOLockUnlock(sweet_fb_copy_lock);
+	}
